# Server Port
PORT=3000

# Frontend URL (For Local: http://localhost:5173, For Production: https://your-frontend-domain.com)
ORIGIN_URL=http://localhost:5173

# Optional comma-separated origins for production/multiple frontends
# ALLOWED_ORIGINS=http://localhost:5173,https://blogger-client-bomz.onrender.com

# Google OAuth Callback URL
# Local: http://localhost:3000/auth/google/callback
# Production: https://your-backend-domain.com/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# MongoDB Connection String
DATABASE='mongodb+srv://<username>:<password>@cluster.mongodb.net/Blog-Post?retryWrites=true&w=majority'

# JWT Secret
SECRET_ACCESS_KEY=your_jwt_secret_key

# AWS S3 (for image uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
SESSION_SECRET=your_session_secret
